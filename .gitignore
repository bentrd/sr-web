# Deps
node_modules
bun.lockb

# Build outputs
dist
build
game/build-*
*.tsbuildinfo

# Local agent session state
.claude/

# WASM artifacts (generated by build:wasm into apps/web/public/)
apps/web/public/sr.js
apps/web/public/sr.wasm
apps/web/public/sr.data
apps/web/public/sr.wasm.map

# Server-side replay validator (built by build:wasm into apps/server/wasm/).
# Built locally before `fly deploy` packages the Docker image.
apps/server/wasm/sr_replay.js
apps/server/wasm/sr_replay.wasm
apps/server/wasm/sr_replay.wasm.map

# Steam Workshop maps — see AGENTS.md, do NOT commit
game/assets/maps/*.sr

# Steam Workshop trails — collected per dev, not redistributed
apps/web/public/trails/*/settings.trail
apps/web/public/trails/*/*.png

# Editor / OS
.DS_Store
.vscode/*
!.vscode/extensions.json
.idea
*.log
*.swp
.env
.env.local

# Vite cache
.vite

# Server leaderboard (auto-created by apps/server on first submit)
apps/server/leaderboard.db*

# Local copy of prod leaderboard (pulled via fly ssh sftp for inspection)
prod-leaderboard.db*
