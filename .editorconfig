root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = tab
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true

[*.{ts,tsx,js,jsx,json,jsonc,yml,yaml,md,html,css}]
indent_style = tab
indent_size = 2

[*.{cpp,h,c,hpp,cmake}]
indent_style = tab
indent_size = 4

[CMakeLists.txt]
indent_style = tab
indent_size = 4

[*.md]
trim_trailing_whitespace = false
